# ═══════════════════════════════════════════════════════════════════════
# Nexus Motion — configuration
#
# Nothing here is required to start: with no keys at all the platform runs on
# its offline engine and still produces a complete, playable episode. Add keys
# to unlock real models; the router picks them up automatically.
# ═══════════════════════════════════════════════════════════════════════

# ── core ───────────────────────────────────────────────────────────────────
ENVIRONMENT=local                       # local | staging | production
SECRET_KEY=change-me-to-32-random-bytes # REQUIRED in production
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | console

# ── datastores ──────────────────────────────────────────────────────────
# sqlite needs no server and is the default for local work.
DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0      # falls back to in-process if absent

# ── storage ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=local                   # local | s3
STORAGE_LOCAL_ROOT=./storage
# S3_BUCKET=nexus-motion
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # R2 / MinIO / B2
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ── pipeline ──────────────────────────────────────────────────────────
MAX_PARALLEL_SHOT_JOBS=6                # concurrent shot generations per job
SHOT_GENERATION_TIMEOUT_S=900
DEFAULT_TARGET_MINUTES=12
RENDER_CRF=20                           # lower = better quality, bigger file
RENDER_PRESET=medium

# ── model routing ─────────────────────────────────────────────────────
ROUTING_PROFILE_DEFAULT=balanced        # offline|free|budget|balanced|premium|flagship
# NEXUS_MODEL_PRICING_FILE=./pricing-overrides.json   # keep prices current without a deploy

# ── LLM providers (writing, storyboarding, continuity) ──────────────────────
ANTHROPIC_API_KEY=                      # Claude Opus 5 / Sonnet 5 — best story quality
OPENAI_API_KEY=
GOOGLE_API_KEY=                         # Gemini 3 — also has a usable free tier
GROQ_API_KEY=                           # free + very fast, good for prompt expansion
DEEPSEEK_API_KEY=                       # cheapest competent long-form writer
OPENROUTER_API_KEY=                     # one key, hundreds of models incl. free pool
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434  # self-hosted, zero marginal cost

# ── image + video providers (the ones that matter for consistency) ────────
FAL_API_KEY=                            # widest surface: Nano Banana Pro, Seedream,
                                        # Kling 3.0, Veo 3.1, Seedance, Wan, LTX
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=                         # Gen-4.5 reference-driven consistency
LUMA_API_KEY=
MINIMAX_API_KEY=
HUGGINGFACE_API_KEY=                    # free tier for trial accounts

# ── voice + music ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=                     # best dramatic delivery + music
CARTESIA_API_KEY=
# edge-tts needs no key and serves the free tier

# ── billing (optional) ──────────────────────────────────────────────
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_SCALE=
CREDIT_MARKUP_MULTIPLIER=1.6            # retail price vs raw provider cost
